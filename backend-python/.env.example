# Server Configuration
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Authentication & Session (Scalekit OAuth)
SESSION_COOKIE_NAME=session
SESSION_JWT_SECRET=replace_with_a_secure_random_32_character_secret!
E2E_TEST_MODE=true
DEFAULT_USER_ROLE=agent
ADMIN_EMAILS=admin@yourcompany.com
AGENT_EMAILS=

SCALEKIT_ENVIRONMENT_URL=https://your-domain.scalekit.dev
SCALEKIT_CLIENT_ID=skc_your_client_id
SCALEKIT_CLIENT_SECRET=your_scalekit_client_secret

# AI Model Providers & Tool Integrations
OPENAI_API_KEY=sk-proj-your-openai-api-key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
TAVILY_API_KEY=tvly-your-tavily-api-key

# PostgreSQL Database with pgvector (e.g. Neon)
DATABASE_URL=postgresql+asyncpg://user:password@ep-your-pooler.region.aws.neon.tech/neondb?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg://user:password@ep-your-host.region.aws.neon.tech/neondb?sslmode=require

# Semantic Retrieval & pgvector Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.3

# Agent Guardrails & Limits
LLM_TIMEOUT_SECONDS=30
MAX_TOOL_CALLS_PER_RUN=8
MAX_OUTPUT_TOKENS=2048

